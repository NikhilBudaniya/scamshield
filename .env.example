# Copy to .env and explicitly source it before starting the server.
# Never commit .env, tokens, service-account JSON, or API keys.

# Local offline mode. Firebase Auth and Firestore are opt-in.
AUTH_MODE=access_code
STORAGE_BACKEND=sqlite
DEMO_ACCESS_CODE=
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false
LOCAL_DEVELOPMENT=true
ENVIRONMENT=development
MAX_ASSESSMENTS_PER_SESSION=100
MAX_EXPLANATIONS_PER_SESSION=100
MAX_ACTIVE_SESSIONS=500
MAX_LOGIN_ATTEMPTS_PER_MINUTE=10

# Invoice uploads are limited to 5 MiB, 10 PDF pages, and 20 megapixels.
# Firestore reservations enforce daily plus lifetime model-attempt limits.
DAILY_MODEL_LIMIT_PER_USER=9
DAILY_MODEL_LIMIT_GLOBAL=50
TOTAL_MODEL_LIMIT_GLOBAL=200

# Firebase web configuration is public client configuration, not a server secret.
# Required only when AUTH_MODE=firebase. Keep Firestore writes server-side.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Default modes make no remote provider calls.
JEV_MODE=fixture
CONTEXT_PROVIDER=jev
GEMINI_MODE=fixture

# For live Gemini, explicitly select developer + GEMINI_API_KEY or vertex + ADC.
# Do not assume a free tier or free credits; eligibility and billing are pending.
GEMINI_BACKEND=vertex
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=8
GEMINI_CLASSIFICATION_TIMEOUT_SECONDS=8
MAX_PROVIDER_CALLS_PER_PROCESS=200

# Jev is optional and independent from Gemini.
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=2

# Optional local PostgreSQL. SQLite is the local default.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/scamshield
