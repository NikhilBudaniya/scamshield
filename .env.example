# Load deliberately into your shell before starting the server.
# Copy this file to .env; never commit credentials.
JEV_MODE=fixture
GEMINI_MODE=fixture
# Use gemini with GEMINI_MODE=live for a Google Cloud-only AI demo.
CONTEXT_PROVIDER=jev

# Set GEMINI_MODE=live after authenticating Google Cloud locally.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Jev is independent from Gemini. Leave fixture until API access is available.
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=2
GEMINI_TIMEOUT_SECONDS=8
GEMINI_CLASSIFICATION_TIMEOUT_SECONDS=8

# Required before exposing this prototype outside your machine.
DEMO_ACCESS_CODE=
SESSION_SECRET=
COOKIE_SECURE=false
LOCAL_DEVELOPMENT=true
MAX_ASSESSMENTS_PER_SESSION=100

# Optional: PostgreSQL via SQLAlchemy psycopg, especially for Cloud Run persistence.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/scamshield
